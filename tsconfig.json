{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "rootDir": "./lib",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2021",
    "lib": ["es2021"],
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["lib/**/*"],
  "exclude": ["node_modules", "dist"]
}
